# Railway Production Environment Variables

# App Keys (generate new ones for production)
APP_KEYS="railway-app-key-1,railway-app-key-2,railway-app-key-3,railway-app-key-4"

# API Token Salt (generate new one for production)
API_TOKEN_SALT="railway-api-token-salt-2024"

# Admin JWT Secret (generate new one for production)
ADMIN_JWT_SECRET="railway-admin-jwt-secret-2024"

# Transfer Token Salt (generate new one for production)
TRANSFER_TOKEN_SALT="railway-transfer-token-salt-2024"

# JWT Secret (generate new one for production)
JWT_SECRET="railway-jwt-secret-2024"

# Database Configuration for Railway PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_URL=${DATABASE_URL}

# Server Configuration
HOST=0.0.0.0
PORT=${PORT}
PUBLIC_URL=${RAILWAY_PUBLIC_DOMAIN}
IS_PROXIED=true

# NODE_ENV
NODE_ENV=production
