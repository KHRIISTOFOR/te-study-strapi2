# Strapi Production Environment Variables

# App Keys (generate new ones for production)
APP_KEYS="your-app-key-1,your-app-key-2,your-app-key-3,your-app-key-4"

# API Token Salt (generate new one for production)
API_TOKEN_SALT="your-api-token-salt"

# Admin JWT Secret (generate new one for production)
ADMIN_JWT_SECRET="your-admin-jwt-secret"

# Transfer Token Salt (generate new one for production)
TRANSFER_TOKEN_SALT="your-transfer-token-salt"

# JWT Secret (generate new one for production)
JWT_SECRET="your-jwt-secret"

# Database Configuration
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Server Configuration
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false

# NODE_ENV
NODE_ENV=production
